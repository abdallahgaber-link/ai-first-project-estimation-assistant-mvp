# ===========================================
# Project Estimation Assistant - Backend Configuration
# ===========================================
# Copy this file to .env and configure your API keys

# Server Configuration
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:8080

# ===========================================
# LLM Provider Configuration
# ===========================================
# Multi-Provider Fallback Configuration
PRIMARY_PROVIDER=azure
# Enable fallback providers (true/false)
ENABLE_FALLBACK=true
FALLBACK_PROVIDERS=gemini,ollama

# ===========================================
# Azure OpenAI Configuration
# ===========================================
# Azure resource name (e.g., myresource)
AZURE_RESOURCE_NAME=your_azure_resource_name

# Azure deployment name (e.g., mydeployment)
AZURE_DEPLOYMENT_NAME=your_azure_deployment_name

# Azure OpenAI API version
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Shared Bearer token provided by company
# Note: Token is passed as query parameter (not header) due to company configuration
AZURE_OPENAI_SHARED_TOKEN=your_azure_shared_token_here

# ===========================================
# Google Gemini Configuration
# ===========================================
# Get API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ===========================================
# Ollama Configuration (Local AI)
# ===========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ===========================================
# Estimation Parameters
# ===========================================
DEFAULT_TEAM_VELOCITY=20
DEFAULT_BUFFER_PERCENT=20

# ===========================================
# Logging Configuration
# ===========================================
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=./logs
