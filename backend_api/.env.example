# ===========================================
# Project Estimation Assistant - Backend Configuration
# ===========================================
# Copy this file to .env and configure your API keys

# Server Configuration
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:8080

# ===========================================
# LLM Provider Configuration
# ===========================================
# Choose your preferred provider: ollama, openai, gemini, azure
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_MODEL=llama3.1:8b

# ===========================================
# Ollama Configuration (Local AI - Recommended for privacy)
# ===========================================
# Install: brew install ollama
# Start: ollama serve
# Pull model: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ===========================================
# OpenAI Configuration
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1

# ===========================================
# Google Gemini Configuration
# ===========================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ===========================================
# Azure OpenAI Configuration
# ===========================================
# Get credentials from Azure OpenAI Studio
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ===========================================
# Estimation Parameters
# ===========================================
DEFAULT_TEAM_VELOCITY=20
DEFAULT_BUFFER_PERCENT=20

# ===========================================
# Logging Configuration
# ===========================================
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=./logs
